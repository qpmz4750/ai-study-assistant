# Copy this file to .env and replace development values as needed.
HOST=0.0.0.0
PORT=8000
# Comma-separated browser origins. Keep localhost entries for local development.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Defaults are <backend>/data/{app.db,chroma,uploads}; set DATA_DIR or each path individually in production.
DATA_DIR=./data
DB_PATH=./data/app.db
CHROMA_DIR=./data/chroma
UPLOAD_DIR=./data/uploads
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
RATE_LIMIT_REQUESTS_PER_MINUTE=10
GEMINI_API_KEY=
